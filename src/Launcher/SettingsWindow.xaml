<Window x:Class="CodexBootAnimation.SettingsWindow" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="Assets/launcher.ico" Title="{Binding Words[Title]}" WindowStartupLocation="CenterScreen"
        Width="936" Height="700" MinWidth="640" MinHeight="490" WindowStyle="None" ResizeMode="CanResize"
        Background="#0A101C" Foreground="#EDF2FC" FontFamily="Segoe UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="64" ResizeBorderThickness="7" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="Text" Color="#EDF2FC" />
        <SolidColorBrush x:Key="Muted" Color="#AEBBD1" />
        <SolidColorBrush x:Key="Ice" Color="#A9D9F7" />
        <SolidColorBrush x:Key="Line" Color="#35415A" />
        <Style x:Key="Focus" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border BorderBrush="#C4EBFF" BorderThickness="2" CornerRadius="8" Margin="-3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="#172133" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#A0C6FA" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.76" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.46" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#B7DEFA" />
            <Setter Property="Foreground" Value="#121C35" />
            <Setter Property="BorderBrush" Value="#C5E6FC" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,3" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#141E30" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ContentPresenter VerticalAlignment="Center" />
                                <Grid Grid.Column="1" Width="15" Height="15" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <Ellipse Stroke="#7489AE" />
                                    <Ellipse x:Name="Dot" Margin="4" Fill="{StaticResource Ice}" Visibility="Hidden" />
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Card" Property="Background" Value="#1C2C45" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="#85B6EC" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#A0C6FA" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Focus}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Padding="0,6">
                            <DockPanel>
                                <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border x:Name="Box" Background="#141E30" CornerRadius="5" BorderBrush="#7489AE" BorderThickness="1" />
                                    <Path x:Name="Check" Data="M 5,10 L 9,14 L 15,6" Stroke="#12233F" StrokeThickness="2" Visibility="Hidden" />
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#C4EBFF" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Ice}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#283751" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="65" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="#0E1626" BorderBrush="#27354C" BorderThickness="0,0,0,1" Padding="26,0,14,0">
                <DockPanel LastChildFill="True">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource CaptionButton}" Content="−" Click="MinimizeClick"
                                ToolTip="{Binding Words[Minimize]}" AutomationProperties.Name="{Binding Words[Minimize]}" />
                        <Button Style="{StaticResource CaptionButton}" Content="×" Click="CloseClick" AutomationProperties.AutomationId="CloseSettings"
                                ToolTip="{Binding Words[Close]}" AutomationProperties.Name="{Binding Words[Close]}" />
                    </StackPanel>
                    <Image x:Name="HeaderIcon" DockPanel.Dock="Left" Width="36" Height="36" Margin="0,0,11,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Neural Overdrive Launcher" FontWeight="SemiBold" FontSize="16" />
                            <TextBlock Text="{Binding LauncherVersion}" Foreground="{StaticResource Ice}" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="11" FontFamily="Consolas" />
                        </StackPanel>
                        <TextBlock Text="{Binding Words[Title]}" Foreground="{StaticResource Muted}" FontSize="12" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel MaxWidth="970" Margin="28,21,28,17" KeyboardNavigation.TabNavigation="Continue">
                    <Border Margin="0,0,0,18" CornerRadius="11" BorderBrush="#354461" BorderThickness="1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#152137" /><GradientStop Color="#15162C" Offset="1" /></LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.19*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Margin="12" Height="156" CornerRadius="7" BorderBrush="#34435D" BorderThickness="1" Background="#060B17">
                                <Border x:Name="ThemeArt" CornerRadius="6">
                                    <TextBlock x:Name="ThemePreviewUnavailable" Text="{Binding Words[ThemePreviewUnavailable]}"
                                               Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.AutomationId="ThemePreviewUnavailable" />
                                </Border>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,14,21,14">
                                <TextBlock Text="{Binding Words[Theme]}" Foreground="{StaticResource Ice}" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding ThemeName}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,4" />
                                <TextBlock Text="{Binding ThemeVersion}" Foreground="#C5B9ED" FontSize="12" FontFamily="Consolas" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Words[ThemeDescription]}" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Style="{StaticResource Heading}" Text="{Binding Words[Mode]}" />
                    <UniformGrid Columns="3" Margin="0,0,0,18" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                        <RadioButton x:Name="QuickMode" GroupName="Modes" Margin="0,0,5,0" Checked="PreferenceChanged"
                                     AutomationProperties.AutomationId="ModeQuick" AutomationProperties.Name="{Binding Words[Quick]}" AutomationProperties.HelpText="{Binding Words[QuickTime]}">
                            <StackPanel><TextBlock Text="{Binding Words[Quick]}" FontWeight="SemiBold" /><TextBlock Text="{Binding Words[QuickTime]}" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="FullMode" GroupName="Modes" Margin="5,0" Checked="PreferenceChanged"
                                     AutomationProperties.AutomationId="ModeCinematic" AutomationProperties.Name="{Binding Words[Full]}" AutomationProperties.HelpText="{Binding Words[FullTime]}">
                            <StackPanel><TextBlock Text="{Binding Words[Full]}" FontWeight="SemiBold" /><TextBlock Text="{Binding Words[FullTime]}" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="DirectMode" GroupName="Modes" Margin="5,0,0,0" Checked="PreferenceChanged"
                                     AutomationProperties.AutomationId="ModeDirect" AutomationProperties.Name="{Binding Words[Direct]}" AutomationProperties.HelpText="{Binding Words[DirectTime]}">
                            <StackPanel><TextBlock Text="{Binding Words[Direct]}" FontWeight="SemiBold" /><TextBlock Text="{Binding Words[DirectTime]}" Foreground="{StaticResource Muted}" FontSize="12" /></StackPanel>
                        </RadioButton>
                    </UniformGrid>

                    <Grid Margin="0,0,0,17">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Background="#111A2B" BorderBrush="#2A3953" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="{Binding Words[Preferences]}" />
                                <TextBlock Text="{Binding Words[Language]}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6" KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Once">
                                    <RadioButton x:Name="English" Content="English" GroupName="Language" Margin="0,0,6,0" Checked="PreferenceChanged" AutomationProperties.AutomationId="LanguageEnglish" />
                                    <RadioButton x:Name="Chinese" Content="简体中文" GroupName="Language" Checked="PreferenceChanged" AutomationProperties.AutomationId="LanguageChinese" />
                                </StackPanel>
                                <CheckBox x:Name="RespectMotion" Checked="PreferenceChanged" Unchecked="PreferenceChanged" AutomationProperties.AutomationId="RespectMotion">
                                    <TextBlock Text="{Binding Words[Motion]}" TextWrapping="Wrap" />
                                </CheckBox>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="#111A2B" BorderBrush="#2A3953" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="{Binding Words[Shortcuts]}" />
                                <WrapPanel>
                                    <Button Content="{Binding Words[CreateLaunch]}" Click="CreateLaunchClick" Margin="0,0,6,6" AutomationProperties.AutomationId="CreateLaunchShortcut" />
                                    <Button Content="{Binding Words[CreateSettings]}" Click="CreateSettingsClick" Margin="0,0,0,6" AutomationProperties.AutomationId="CreateSettingsShortcut" />
                                </WrapPanel>
                                <Button Content="{Binding Words[Remove]}" Click="RemoveClick" HorizontalAlignment="Left" AutomationProperties.AutomationId="RemoveShortcuts" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <DockPanel LastChildFill="True">
                        <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                            <Button x:Name="PreviewButton" Content="{Binding Words[Preview]}" ToolTip="{Binding Words[PreviewHint]}" Click="PreviewClick" Margin="0,0,7,5" AutomationProperties.AutomationId="PreviewAnimation" />
                            <Button x:Name="LaunchButton" Content="{Binding Words[Launch]}" ToolTip="{Binding Words[LaunchHint]}" Click="LaunchClick" Margin="0,0,7,5" AutomationProperties.AutomationId="LaunchCodex" />
                            <Button Style="{StaticResource Primary}" Content="{Binding Words[Save]}" Click="SaveClick" Margin="0,0,0,5" AutomationProperties.AutomationId="SaveSettings" />
                        </WrapPanel>
                        <Button Content="{Binding Words[Reset]}" Click="ResetClick" HorizontalAlignment="Left" Margin="0,0,5,5" AutomationProperties.AutomationId="ResetSettings" />
                    </DockPanel>
                    <TextBlock x:Name="StatusLine" Text="{Binding Status}" Foreground="{StaticResource Ice}" TextWrapping="Wrap"
                               Margin="0,3,0,0" MinHeight="18" FontSize="12" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="SettingsStatus" />
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" BorderBrush="#27354C" BorderThickness="0,1,0,0" Background="#0E1626" Padding="28,10">
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding LauncherVersion}" Foreground="{StaticResource Ice}" FontSize="12" FontFamily="Consolas" />
                    <TextBlock Text="{Binding Words[Unofficial]}" Foreground="{StaticResource Muted}" FontSize="12" />
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
